{
  "manifest_version": 3,
  "name": "LMemM — Save project context",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "contextMenus", "storage"],
  "incognito": "not_allowed",
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Save to LMemM — choose a project first"},
  "options_page": "popup.html",
  "commands": {
    "save_selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save selected text to LMemM"}
  }
}
